# ManuView Environment Configuration
# Copy this file to .env.local and add your preferred LLM provider key:
# cp .env.example .env.local

# -------------------------------------------------------------
# Option 1: Google Gemini (Recommended - Fast & Free Tier Available)
# Get a key at: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=
# Optional model override (default: gemini-1.5-flash or gemini-2.0-flash)
# GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# Option 2: Groq (Ultra-Fast Llama 3.3 - Free Tier Available)
# Get a key at: https://console.groq.com/keys
# -------------------------------------------------------------
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------------
# Option 3: OpenAI (GPT-4o / GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
# -------------------------------------------------------------
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# Option 4: Anthropic Claude (Claude 3.5 Sonnet)
# Get a key at: https://console.anthropic.com/
# -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (default: claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# Option 5: Local Ollama (100% Offline, Free & Private)
# Install & run: https://ollama.com
# -------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3
